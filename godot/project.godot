; Ultrakickoff Godot port — fan-made, non-afiliasi.
; Nama klub/stadion pakai nama asli sebagai data faktual, rating + pemain estimasi sendiri.
config_version=5

[application]

config/name="Ultrakickoff"
config/description="Manager simulasi Liga Indonesia — versi Godot (port dari JS). Tanpa HTML5."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.043, 0.07, 0.125, 1)

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.043, 0.07, 0.125, 1)
